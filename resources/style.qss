/*
 * Transaction Importer design system
 * Neutral surfaces, one blue accent, and a compact 8 px spacing rhythm.
 */

QMainWindow,
QWidget#app-shell {
    background: #F4F7FB;
    color: #182230;
}

QWidget#sidebar {
    background: #EDF3FA;
    border-right: 1px solid #D9E2EC;
}

QWidget#content-area,
QWidget#page-container,
QStackedWidget {
    background: #F4F7FB;
    border: none;
}

QWizardPage,
QWidget#import-file-page,
QWidget#auth-page,
QWidget#actual-auth-page,
QWidget#account-select-page,
QWidget#transactions-page,
QWidget#review-page,
QWidget#finish-page {
    background: transparent;
    border: none;
}

QFrame#card-panel {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QLabel {
    color: #27364B;
    font-size: 14px;
}

QLabel[role="sidebar-eyebrow"] {
    color: #607086;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel[role="sidebar-title"] {
    color: #14243A;
    font-size: 23px;
    font-weight: 700;
}

QLabel[role="sidebar-description"] {
    color: #607086;
    font-size: 12px;
    line-height: 1.4;
}

QLabel#target-badge {
    color: #235A97;
    background: #DCEBFA;
    border: 1px solid #C6DDF4;
    border-radius: 8px;
    padding: 9px 11px;
    font-size: 12px;
    font-weight: 600;
}

QLabel[role="eyebrow"] {
    color: #0066CC;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel[role="page-title"] {
    color: #14243A;
    font-size: 25px;
    font-weight: 700;
}

QLabel[role="page-description"] {
    color: #607086;
    font-size: 14px;
}

QLabel[role="field-label"] {
    color: #27364B;
    font-size: 13px;
    font-weight: 600;
}

QFrame#mode-panel {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 9px;
}

QFrame#drop-zone {
    background: #F6FAFE;
    border: 2px dashed #9BBFE4;
    border-radius: 12px;
}

QFrame#drop-zone[drag="true"],
QFrame#drop-zone:hover,
QFrame#drop-zone:focus {
    background: #EDF6FF;
    border-color: #0066CC;
}

QFrame#drop-zone QLabel,
QFrame#drop-zone QSvgWidget {
    background: transparent;
}

QFrame#drop-zone QLabel[role="drop-title"] {
    color: #24364B;
    font-size: 17px;
    font-weight: 600;
}

QLabel#supported-label {
    color: #607086;
    font-size: 12px;
}

QLabel#helper-link,
QLabel[objectName="helper-link"] {
    color: #0066CC;
    font-size: 13px;
}

QWidget#selected-file-panel {
    background: #F0F7FF;
    border: 1px solid #C9DFF5;
    border-radius: 9px;
}

QLabel#file-name-label {
    color: #24364B;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

QLabel#helper-label,
QLabel#cache-label,
QLabel#info-label {
    color: #607086;
    font-size: 12px;
}

QLabel#error-label {
    color: #B42318;
    font-size: 12px;
}

QLabel#counts-label {
    color: #344054;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 7px;
    padding: 8px 10px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#completion-details {
    color: #526277;
    font-size: 15px;
    min-width: 480px;
}

QLineEdit,
QComboBox {
    color: #182230;
    background: #FFFFFF;
    border: 1px solid #C8D2DF;
    border-radius: 7px;
    min-height: 42px;
    padding: 0 12px;
    font-size: 14px;
    selection-background-color: #CFE5FA;
}

QLineEdit:hover,
QComboBox:hover {
    border-color: #8DA2BA;
}

QLineEdit:focus,
QComboBox:focus {
    border: 2px solid #2680D9;
    padding: 0 11px;
}

QLineEdit:disabled,
QComboBox:disabled {
    color: #8A96A8;
    background: #F1F4F8;
    border-color: #D9E2EC;
}

QComboBox::drop-down {
    width: 32px;
    border: none;
}

QComboBox QAbstractItemView {
    color: #182230;
    background: #FFFFFF;
    border: 1px solid #C8D2DF;
    selection-background-color: #E4F1FD;
    selection-color: #182230;
    outline: none;
    padding: 4px;
}

QCheckBox,
QRadioButton {
    color: #344054;
    font-size: 14px;
    spacing: 7px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QPushButton {
    color: #27364B;
    background: #FFFFFF;
    border: 1px solid #C8D2DF;
    border-radius: 7px;
    min-height: 38px;
    padding: 0 16px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton:hover {
    background: #F4F7FB;
    border-color: #8DA2BA;
}

QPushButton:pressed {
    background: #E9EEF5;
}

QPushButton:disabled {
    color: #98A2B3;
    background: #EEF2F6;
    border-color: #E2E8F0;
}

QPushButton#browse-btn,
QPushButton#continue-btn {
    color: #FFFFFF;
    background: #0066CC;
    border: 1px solid #0066CC;
}

QPushButton#browse-btn {
    min-width: 156px;
}

QPushButton#browse-btn:hover,
QPushButton#continue-btn:hover {
    background: #0055AA;
    border-color: #0055AA;
}

QPushButton#browse-btn:pressed,
QPushButton#continue-btn:pressed {
    background: #00498F;
}

QPushButton#continue-btn:disabled {
    color: #8A96A8;
    background: #D9E2EC;
    border-color: #D9E2EC;
}

QPushButton#back-btn,
QPushButton#secondary-btn,
QPushButton#show-token-btn {
    color: #344054;
    background: #FFFFFF;
    border: 1px solid #C8D2DF;
}

QPushButton#clear-btn {
    color: #B42318;
    background: transparent;
    border: none;
    min-height: 28px;
    padding: 0 4px;
    font-size: 12px;
}

QPushButton#clear-btn:hover {
    color: #8F1C13;
    background: #FEECEB;
}

QWidget#nav-button-container {
    background: #FFFFFF;
    border: none;
}

QFrame#nav-separator {
    color: #E2E8F0;
    background: #E2E8F0;
    border: none;
    max-height: 1px;
}

QTableWidget {
    color: #27364B;
    background: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #D9E2EC;
    border-radius: 8px;
    gridline-color: #E8EDF3;
    font-size: 13px;
    outline: none;
}

QTableWidget::item {
    padding: 7px 9px;
    border-bottom: 1px solid #EEF2F6;
}

QTableWidget::item:selected {
    color: #182230;
    background: #DDEEFF;
}

QHeaderView::section {
    color: #475467;
    background: #F1F5F9;
    border: none;
    border-bottom: 1px solid #D9E2EC;
    padding: 8px 9px;
    font-size: 12px;
    font-weight: 700;
}

QTableCornerButton::section {
    background: #F1F5F9;
    border: none;
}

QToolTip {
    color: #FFFFFF;
    background: #27364B;
    border: none;
    padding: 6px 8px;
}

QSvgWidget {
    background: transparent;
}
